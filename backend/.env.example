# ==============================================================================
# Sri Meenakshi Agro & Traditional Foods Pvt Ltd - ERP Production Configuration
# Phase 15: Environment Variables Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL 15+)
# For local PostgreSQL:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_db_password_here
PGDATABASE=food_mfg_db

# Or use Managed Cloud PostgreSQL Connection URI (Neon, Supabase, Render, AWS RDS):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/food_mfg_db?sslmode=require

# Authentication / Security
# Generate a cryptographically secure 64-character secret in production
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
JWT_EXPIRES_IN=24h

# Security & CORS (Comma-separated list of allowed frontend origins)
CORS_ORIGIN=https://sri-meenakshi-erp.vercel.app,http://localhost:5173

# Company Profile & Statutory GST Baseline (Tamil Nadu State Code: 33)
COMPANY_NAME=Sri Meenakshi Agro & Traditional Foods Pvt Ltd
COMPANY_GSTIN=33AAAAA0000A1Z5
COMPANY_STATE_CODE=33
COMPANY_STATE_NAME=Tamil Nadu
COMPANY_ADDRESS=Plot No. 42-B, SIDCO Industrial Estate, Kappalur, Madurai, Tamil Nadu - 625008
COMPANY_PHONE=+91 98420 12345
COMPANY_EMAIL=accounts@meenakshifoods.in
